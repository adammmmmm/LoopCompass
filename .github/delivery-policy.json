{
  "schema": 1,
  "trusted_contributors": [
    "adammmmmm"
  ],
  "human_maintainers": [
    "adammmmmm"
  ],
  "required_model_reviews": 3,
  "implementation_branch_patterns": [
    "codex/**",
    "feature/**",
    "fix/**"
  ],
  "sensitive_paths": [
    ".github/workflows/**",
    ".github/actions/**",
    ".github/delivery-policy.json",
    ".github/CONTRIBUTING.md",
    ".github/PULL_REQUEST_TEMPLATE.md",
    "docs/maintainer-delivery-policy.md",
    "scripts/review-gate.mjs",
    "scripts/lib/review-gate.mjs",
    "scripts/release.mjs",
    "scripts/verify.mjs",
    "tests/review-gate.test.mjs",
    "tests/repository-health.test.mjs",
    "fixtures/review-gate/**",
    "**/auth/**",
    "**/*auth*",
    "**/permissions/**",
    "**/*permission*",
    "**/migrations/**",
    "**/*migration*",
    "**/security/**",
    "**/*security*",
    "**/*credential*",
    "**/*secret*"
  ],
  "desired_ruleset": {
    "strict_required_status_checks": true,
    "required_status_checks": [
      {
        "context": "verify",
        "integration_id": 15368
      },
      {
        "context": "model-review-gate",
        "integration_id": 15368
      },
      {
        "context": "delivery-policy",
        "integration_id": 15368
      }
    ],
    "allowed_merge_methods": [
      "squash"
    ],
    "required_review_thread_resolution": true,
    "bypass_actors": []
  },
  "desired_repository_settings": {
    "allow_auto_merge": true,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": true
  }
}
