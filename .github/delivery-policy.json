    "scripts/review-gate.mjs",
    "scripts/lib/review-gate.mjs",
    "scripts/release.mjs",
    "tests/review-gate.test.mjs",
    "fixtures/review-gate/**",
    "**/auth/**",
    "**/*auth*",
    "**/permissions/**",
    "**/*permission*",
    "**/migrations/**",
    "**/*migration*",
    "**/security/**",
    "**/*security*",
    "**/*credential*",
    "**/*secret*"
  ]
}
