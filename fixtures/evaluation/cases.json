    "stale_rejection_rate",
    "repeated_failure_reduction",
    "blind_retry_rate",
    "time_to_verified_normal_path",
    "terminal_outcome_compliance",
    "terminal_receipt_completeness",
    "terminal_receipt_semantic_accuracy",
    "worker_to_parent_closure"
  ],
